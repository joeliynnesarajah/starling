# Copy to backend/.env and edit. Never commit .env.

ENGINE_URL=http://localhost:8001

# 1 = never call ONS, read app/ons/cache/ons_cache.json only (use this for the demo)
OFFLINE=0

# LLM fallback for merchants with no MCC (Person 2). Leave off if nobody has a key.
USE_LLM=0
ANTHROPIC_API_KEY=

# Savings interest rate on the Space as a decimal, e.g. 0.03 for 3%
SAVINGS_INTEREST_RATE=0.0

FRONTEND_ORIGIN=http://localhost:5173

USE_LLM=false
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=